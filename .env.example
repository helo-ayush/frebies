# Public site URL (used for canonical URLs, sitemap, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk Authentication (add keys from https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# Rate limiting (optional at launch)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email (Supabase custom SMTP / OTP delivery)
RESEND_API_KEY=

# AI providers
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_DUB_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ModelScope Drama 3 TTS Studios (least-queue routing & auto-wake)
MODELSCOPE_API_TOKEN=
MODELSCOPE_OPENAPI_ENDPOINT=https://www.modelscope.ai
MODELSCOPE_TTS_STUDIOS=helo-ayush/AudioTTS3,helo-ayush/AudioTTS2
MODELSCOPE_TTS_URLS=https://studio-helo-ayush-audiotts3.api-inference.modelscope.ai,https://studio-helo-ayush-audiotts2.api-inference.modelscope.ai
MODELSCOPE_MAX_CONCURRENT_PER_STUDIO=2
MODELSCOPE_WAKE_ALL_ON_VISIT=true

# Cron and observability
CRON_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Object Storage for temporary 24h generations (Tigris recommended: 5 GB free, $0 egress, no credit card)
# Create a bucket & access key at https://storage.new
S3_ENDPOINT=https://t3.storage.dev
S3_REGION=auto
S3_BUCKET_NAME=frebies-generations
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: path-style requests (set true only for providers like Supabase Storage)
# S3_FORCE_PATH_STYLE=false

# Shared generation retention & FIFO queue eviction limits
# 24h auto-expire window per generated item
GENERATION_TTL_HOURS=24
# Global storage soft cap (4700 MB = ~4.7 GB stays safely under Tigris 5 GB free tier)
# When full, oldest generations are evicted first (even before 24h completes)
GENERATION_MAX_STORAGE_MB=4700
# Optional per-user quota in MB once sign-in is enabled (0 = unlimited up to bucket cap)
GENERATION_OWNER_MAX_STORAGE_MB=0
